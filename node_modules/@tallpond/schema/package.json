{
  "name": "@tallpond/schema",
  "version": "0.1.0",
  "description": "Schema DSL for tallpond — define tables, resources, and access rules in a .tallpond.schema.ts, deployed via the tallpond CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CarsonJoe/tallpond.git",
    "directory": "packages/schema"
  },
  "homepage": "https://tallpond.com",
  "keywords": [
    "tallpond",
    "schema",
    "dsl"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
